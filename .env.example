# Supabase transaction pooler (port 6543) for application requests.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase direct connection or session pooler (port 5432) for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Generate at least 32 random characters. Never reuse production in previews.
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Required for Contact message delivery (Resend). ARTIST_EMAIL receives
# inquiries; EMAIL_FROM is the verified sender identity.
RESEND_API_KEY=""
ARTIST_EMAIL=""
EMAIL_FROM=""

# Preview and development deployments should remain non-indexable.
ALLOW_INDEXING="false"

# Optional deterministic non-production seed credential.
SEED_ADMIN_PASSWORD=""
